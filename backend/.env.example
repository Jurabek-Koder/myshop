# =============================================================================
# MyShop backend — NAMUNA (.env.example)
# Bu faylni gitga commit qiling; haqiqiy parollarni .env da saqlang (.env gitga tushmasin).
# Lokal: backend/.env yarating — powerda: copy .env.example .env
# =============================================================================

# =============================================================================
# PRODUCTION — brauzerda sayt ishlashi uchun (avvalo shularni to‘ldiring)
# Batafsil: ../DEPLOY.md
# =============================================================================
# NODE_ENV=production
# PORT=3000
# TZ=Asia/Tashkent
#
# Render / server: SQLite + yuklanmalar — doimiy disk (masalan Render → Disks).
# Bo‘lmasa qayta deployda baza yo‘qoladi: har safar yangi ro‘yxat, login xatosi.
# MYSHOP_DATA_DIR=/data/myshop
#
# JWT kalitlari — uzun, tasodifiy; gitga TUSHIRMASLIK. Kamida ~32 belgi.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
#
# Brauzerdagi frontend URL(lar)i — vergul bilan. Sxema B da ikkala domen kerak bo‘lishi mumkin.
# CORS_ORIGINS=https://shop.sizning-domen.uz,https://www.sizning-domen.uz
#
# Bir domen uchun qisqa usul:
# FRONTEND_URL=https://frontend-xxxxx.onrender.com
#
# Ixtiyoriy: operator/AI webhook himoyasi (frontend VITE_APP_SECRET_KEY bilan bir xil)
# MYSHOP_APP_SECRET_KEY=
#
# Render: sukut diski tasdiqlash (FAQAT demo; prod da disk + MYSHOP_DATA_DIR bering).
# RENDER=true
# MYSHOP_ALLOW_EPHEMERAL_DISK=1
#
# Bitta servisda SPA serv qilish (prod sukut 1; alohida static host bo‘lsa 0)
# MYSHOP_SERVE_SPA=1
# MYSHOP_SERVE_SPA=0 bo‘lsa: statik build yo‘li
# FRONTEND_DIST=../frontend/dist
# =============================================================================

# =============================================================================
# Supabase — mahsulot + rollar bulut aks-nusxasi (SQL: repodagi supabase/migrations/)
# SERVICE_ROLE kalitni faqat serverda ishlating; git / frontend ga bermang.
# =============================================================================
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Avto-sync o‘chirish (faqat qo‘lda npm run sync-supabase-push):
# SUPABASE_MIRROR_SYNC_ENABLED=0
# SUPABASE_SYNC_INTERVAL_MS=120000

# Sklad jamoa chat avto-yordamchi (ixtiyoriy)
# MYSHOP_SKLAD_BOT_DISABLED=1
# MYSHOP_SKLAD_BOT_ALWAYS_REPLY=1
# MYSHOP_SKLAD_BOT_OPENAI_KEY=sk-...
# MYSHOP_SKLAD_BOT_OPENAI_MODEL=gpt-4o-mini
# MYSHOP_SKLAD_BOT_NAME=MyShop bot
# MYSHOP_SKLAD_BOT_MIN_GAP_MS=2000

# =========================
# AI Call-Operator (Vapi)
# =========================
# Webhook himoyasi (Vapi -> backend) va operator endpointlari (frontend -> backend)
# MYSHOP_APP_SECRET_KEY=change-me-strong
#
# Transcriptlar DB’da AES-256-GCM bilan saqlanadi.
# 32 byte KEY: hex (64 belgi) yoki base64 (32 byte decode).
# MYSHOP_AI_TRANSCRIPTS_AES_KEY=base64_or_hex_32_bytes
#
# Admin panel: 2 ta sinov audio (superuser «2 ta test audio qo‘shish»). Prod’da o‘chiq qoldiring.
# MYSHOP_AI_TEST_SAMPLES=1
#
# Test dialog: har bir gap uchun OpenAI MP3 + <audio controls> (admin «Test suhbat — MP3 playerlar»).
# MYSHOP_TEST_DIALOG_OPENAI_KEY=sk-...
# MYSHOP_TEST_DIALOG_TTS_MODEL=gpt-4o-mini-tts
# MYSHOP_TEST_DIALOG_VOICE_MIJOZ=marin
# MYSHOP_TEST_DIALOG_VOICE_OPERATOR=sage
# MYSHOP_TEST_DIALOG_TTS_SPEED=0.94
#
# Vapi API
# MYSHOP_VAPI_TOKEN=...
# MYSHOP_VAPI_PHONE_NUMBER_ID=...
#
# Vapi server webhook URL (HTTPS tavsiya; lokal dev uchun tunnel: ngrok/cloudflared)
# MYSHOP_VAPI_WEBHOOK_URL=https://your-domain.com/api/operator/ai-call/webhook
#
# Model (ixtiyoriy)
# MYSHOP_VAPI_OPENAI_MODEL=gpt-4o-mini

# Qo‘ng‘iroq boshlanishi (mega-prompt: operator birinchi salomlaydi)
# MYSHOP_VAPI_FIRST_MESSAGE_MODE=assistant-speaks-first
# MYSHOP_VAPI_FIRST_MESSAGE=Assalomu alaykum, MyShopdan qo'ng'iroq qilyapman. Siz buyurtma bergandingiz.
#
# Mijozga “inson operator” tuyg‘usi: ism + ovoz provayderi
# MYSHOP_AI_OPERATOR_NAME=Nilufar
#
# Ovoz: openai (default) yoki elevenlabs
# MYSHOP_VAPI_VOICE_PROVIDER=openai
# OpenAI TTS: marin | shimmer | cedar | alloy | … ; sekinroq = tabiiroq
# MYSHOP_VAPI_OPENAI_VOICE_ID=marin
# MYSHOP_VAPI_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# MYSHOP_VAPI_VOICE_SPEED=0.96
# MYSHOP_VAPI_VOICE_INSTRUCTIONS=Warm natural call center agent, Uzbek/Russian, never robotic.
#
# Eng tabiiy (lekin 11labs hisob + voice id kerak):
# MYSHOP_VAPI_VOICE_PROVIDER=11labs
# MYSHOP_VAPI_ELEVENLABS_VOICE_ID=...
# MYSHOP_VAPI_ELEVENLABS_MODEL=eleven_multilingual_v2
# eleven_turbo_v2_5 bo‘lsa tilni majburan: # MYSHOP_VAPI_ELEVEN_LANGUAGE=uz yoki ru
#
# Transkripsiya: deepgram multi (telefon) yoki o‘chirish: MYSHOP_VAPI_TRANSCRIBER=off
# MYSHOP_VAPI_DEEPGRAM_MODEL=nova-2-phonecall
# MYSHOP_VAPI_DEEPGRAM_ENDPOINTING=300
#
# Bull (Redis)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Admin: Meta (ixtiyoriy)
# META_ACCESS_TOKEN=

# Seller panel: stock fotolar (ixtiyoriy)
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# Mijoz ro‘yxatdan o‘tishi: superuser (vergul bilan; bo‘sh = faqat birinchi foydalanuvchi)
# MYSHOP_SUPERUSER_EMAILS=joraaxmedov620@gmail.com

# =========================
# Server va deploy — asosiy ro‘yxat fayl boshidagi PRODUCTION blokda
# =========================
