# -----------------------------------------------------------------------------
# Backend uchun (ildizdagi .gitignore bilan birga ishlaydi).
# Ildiz: node_modules/, .env, *.db, uploads/ (umumiy), dist/ va boshqalar.
# -----------------------------------------------------------------------------

# Yuklangan fayllar (MYSHOP_DATA_DIR yo‘q bo‘lsa ko‘pincha shu yerda yoziladi)
uploads/

# Sukut SQLite papkasi (getDataDir → backend/data — agar MYSHOP_DATA_DIR bermagan bo‘lsangiz)
data/

# Qayta takror (ildizda ham *.db bor; bu yerda backend papkasiga nisbatan aniq)
*.db
*.db-shm
*.db-wal
