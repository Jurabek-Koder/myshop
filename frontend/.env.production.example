# =============================================================================
# PRODUCTION BUILD — nusxa: .env.production
# Vite faqat `npm run build` vaqtida shu faylni o‘qiydi; o‘zgarganda qayta build.
# =============================================================================

# --- Variant A: sayt va API bir xil domen (masalan Nginx: /api → Node) ---
# Hech narsa yozmasangiz yoki quyidagi qatorni # qiling — so‘rovlar /api ga nisbiy ketadi.
# VITE_API_BASE_URL=

# --- Variant B: API alohida subdomen / server ---
# Oxirida / qo‘ymang.
# VITE_API_BASE_URL=https://api.sizning-domen.uz

# --- Ixtiyoriy: maxsus operator/AI endpointlar (backend MYSHOP_APP_SECRET_KEY bilan bir xil) ---
# VITE_APP_SECRET_KEY=uzun-tasodifiy-maxfiy-kalit

# Eslatma: VITE_PACKER_DEMO va boshqa dev-flaglar production buildda odatda ishlatilmaydi.
