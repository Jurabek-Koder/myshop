# Vite «npm run dev» — /api so‘rovlarini shu manzilga yo‘natadi.
# Backend terminalidagi port bilan bir xil bo‘lishi kerak (masalan: «API http://localhost:3000»).
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Lokal rivojlantirishda odatda yozmay qo‘ying: so‘rovlar /api orqali proxy orqali ketadi.
# Faqat maxsus holatda: VITE_API_BASE_URL=http://192.168.1.10:3000 kabi (oxiriga / qo‘ymang).
